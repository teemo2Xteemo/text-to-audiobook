# Copy to .env and adjust. Do not commit .env.
# Names only — put credentials in the untracked .env file, never here.

REDIS_URL=redis://redis:6379/0
# Must be a real directory, not a symlink. Compose bind-mounts ./storage here.
# The API/worker entrypoint lchown's this tree as root on every start (can be
# slow as storage/ grows), then drops to uid 1000.
STORAGE_PATH=/data/storage
OUTPUT_BITRATE_KBPS=128
# Single upload cap, in bytes (50 MiB). The API enforces it and publishes it as
# limits.max_upload_bytes on GET /api/capabilities; the UI reads that value.
# 1M CJK characters ≈ 3 MB UTF-8; 1M Latin or Vietnamese characters ≈ 1–1.5 MB.
MAX_UPLOAD_BYTES=52428800

# M5 defaults: offline fakes. Override later for real providers, e.g.:
# TRANSLATION_PROVIDER=nllb
# TTS_PROVIDER=edge
# Optional per-language default (vendor voice IDs). Unset = first voices_for() entry.
# TTS_DEFAULT_VOICE_BY_LANGUAGE=vi-VN=vi-VN-HoaiMyNeural,zh-CN=zh-CN-XiaoxiaoNeural
TRANSLATION_PROVIDER=fake
TTS_PROVIDER=fake
# Extra TTS engines a job may pin via tts_engine, e.g. edge,fish,vieneu (default engine always allowed):
# TTS_ENGINES_ENABLED=
# Explicit "Continue with Edge" after a Fish/VieNeu failure. Nothing switches engines by itself.
# TTS_FALLBACK_SCOPE=off hides the button and rejects the endpoint. chapter (default) offers it
# for unfinished chapters only. TTS_FALLBACK_ENGINE must be "edge" or empty (empty hides the
# button). Any other value prevents the process from starting.
# TTS_FALLBACK_ENGINE=edge
# TTS_FALLBACK_SCOPE=chapter
# Fish Audio model id and VieNeu precision (both feed the TTS cache key):
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_API_KEY=
FISH_AUDIO_BASE_URL=https://api.fish.audio
# lang=reference_id[:label], comma separated
FISH_AUDIO_VOICES=
FISH_AUDIO_HTTP_TIMEOUT_SECONDS=120
FISH_AUDIO_MAX_CONCURRENCY=2
# VieNeu-TTS sidecar (docker compose --profile vieneu up); precision is fp32 or int8
# CPU VieNeu is slow (RTF ~0.5-0.7): raise RQ_JOB_TIMEOUT_SECONDS for book-length jobs.
VIENEU_BASE_URL=http://vieneu:8000/v1
VIENEU_MODEL=vieneu-v3-turbo
VIENEU_HTTP_TIMEOUT_SECONDS=300
VIENEU_MAX_CONCURRENCY=1
VIENEU_PRECISION=fp32
# Host path for the sidecar model cache (default: named volume vieneu-models)
# VIENEU_MODEL_DIR=
WORKER_CONCURRENCY=1
# Bounded concurrency for chunks inside a single job:
CHUNK_TRANSLATION_CONCURRENCY=2
CHUNK_TTS_CONCURRENCY=2
# Text chunk character budget for pipeline/translation (default 1200):
CHUNK_MAX_CHARS=1200
# Edge TTS payload limit per API call (sub-chunking for audio synthesis):
EDGE_TTS_MAX_CHARS=500
# Deadline for one whole chunk (all Edge sub-calls and in-client retries). Timeouts are
# retried only by RETRY_MAX_ATTEMPTS, so worst case per chunk is roughly
# RETRY_MAX_ATTEMPTS * EDGE_TTS_TIMEOUT_SECONDS plus a few seconds of retry backoff
# (~3 * 90s = 270s), well under RQ_JOB_TIMEOUT_SECONDS. The budget is shared by all
# ceil(CHUNK_MAX_CHARS / EDGE_TTS_MAX_CHARS) sub-calls: raise it if you raise
# CHUNK_MAX_CHARS.
EDGE_TTS_TIMEOUT_SECONDS=90
# WORKER_CONCURRENCY>1 forks extra RQ worker processes inside one container. It is
# experimental: dead children are not restarted and shutdown waits only 5s. Prefer
# `docker compose up --scale worker=N` for more capacity. Per-job locking uses flock, so
# all workers must share one host and a local (non-NFS) STORAGE_PATH.
NLLB_MODEL_ID=facebook/nllb-200-distilled-600M
# Optional literary translation (ADR 0011). Leave TRANSLATION_PROVIDER=fake/nllb
# unless Ollama is running with a pulled TranslateGemma (or compatible) model.
# Compose defaults OLLAMA_BASE_URL to host.docker.internal (api/worker extra_hosts).
# Host-run worker (no Compose): OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_TRANSLATION_MODEL=translategemma:4b
# Per-request HTTP timeout; distinct from RQ_JOB_TIMEOUT_SECONDS.
# OLLAMA_HTTP_TIMEOUT_SECONDS=120
# Optional Google Gemini translation provider (TRANSLATION_PROVIDER=gemini)
# GEMINI_API_KEY=
# GEMINI_TRANSLATION_MODEL=gemini-3.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_HTTP_TIMEOUT_SECONDS=60
# Optional Groq translation provider (TRANSLATION_PROVIDER=groq)
# GROQ_API_KEY=
# GROQ_TRANSLATION_MODEL=qwen/qwen3.8-27b
# Curated profiles: groq-qwen, groq-gpt-oss-120b (openai/gpt-oss-120b),
# groq-gpt-oss-20b (openai/gpt-oss-20b). A saved pin that still names a
# retired Llama id is rewritten to the matching gpt-oss model.
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_HTTP_TIMEOUT_SECONDS=60
# Optional OpenRouter translation provider (TRANSLATION_PROVIDER=openrouter)
# OPENROUTER_API_KEY=
# Default profile when this provider is selected: openrouter-deepseek-v4-flash.
# OPENROUTER_TRANSLATION_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_TIMEOUT_SECONDS=60
LANGUAGE_DETECT_MIN_CONFIDENCE=0.5
LANGUAGE_CONFIRM_THRESHOLD=0.70
TTS_PREVIEW_RATE_PER_MINUTE=30
ESTIMATE_CHARS_PER_SECOND=15.0
ESTIMATE_TRANSLATION_EXPANSION=1.2
# Silence inserted between chapters when narrating chaptered text (0 disables).
NARRATE_CHAPTER_PAUSE_MS=1500
# Optional per-job "spell out numbers & dates" step (opt-in on the UI). It reuses the
# chat provider's GROQ_* / OPENROUTER_* key and model and adds LLM cost: none | groq | openrouter.
TEXT_NORMALIZER_PROVIDER=none
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=1
# Provider rate limits (HTTP 429) get a longer retry budget; waits double, capped at 120s.
RETRY_RATE_LIMIT_MAX_ATTEMPTS=6
RETRY_RATE_LIMIT_BACKOFF_SECONDS=5
# Crash recovery cap (distinct from RETRY_MAX_ATTEMPTS, which is per-chunk provider
# retries). On worker boot, a job that was already running (not QUEUED) is re-enqueued and
# counted. The counter resets when a chunk checkpoint is recorded, so a long
# GENERATING_AUDIO stage can crash more than this many times while it is still
# advancing. After this many recoveries with no new checkpoint it is marked FAILED.
MAX_RECOVERY_ATTEMPTS=3
# RQ kills the worker function after this many seconds (hard backstop). CPU NLLB
# first load can exceed RQ's 180s default (~172s still translating on a 8 GB box).
# Raising it is an escape hatch for a single long run; book-length jobs continue
# themselves across runs (see JOB_RUN_BUDGET_SECONDS) instead of needing Retry.
RQ_JOB_TIMEOUT_SECONDS=1800
# Cooperative budget for one worker run, strictly below RQ_JOB_TIMEOUT_SECONDS.
# Unset: timeout - 120 seconds, with a floor of 60 (or timeout - 5 when the RQ
# timeout is 60s or less). The 120s is headroom so an in-flight chunk can finish
# before RQ's hard kill. One provider call longer than the RQ timeout still hits
# that kill; if the run recorded a checkpoint, the job is re-enqueued instead of
# failed. The worker stops pulling new chunks and the UI stays on the real stage.
# JOB_RUN_BUDGET_SECONDS=
# Fail a job that makes no checkpoint progress for this many runs in a row.
MAX_STALLED_RUNS=3
# Safety cap on continuation runs (the original run is not counted).
MAX_JOB_RUNS=500

# Compose worker only: Hugging Face cache inside the container (not a Settings field).
# First NLLB run downloads distilled weights into this path (named volume huggingface-cache).
# HF_HOME=/data/huggingface

# Frontend (Vite). Empty base URL = same-origin /api via nginx or the Vite dev proxy.
# VITE_* are baked at frontend image build. After changing them: docker compose up --build
VITE_API_BASE_URL=
VITE_DEFAULT_SOURCE_LANGUAGE=auto
# Optional UI preselect only; must also appear in GET /api/capabilities.
# VITE_DEFAULT_TARGET_LANGUAGE=vi-VN
