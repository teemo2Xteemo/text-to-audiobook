# Copy to .env and adjust. Do not commit .env.
# Names only — put credentials in the untracked .env file, never here.

REDIS_URL=redis://redis:6379/0
STORAGE_PATH=/data/storage
OUTPUT_BITRATE_KBPS=128
MAX_UPLOAD_BYTES=2000000

# M5 defaults: offline fakes. Override later for real providers, e.g.:
# TRANSLATION_PROVIDER=nllb
# TTS_PROVIDER=edge
TRANSLATION_PROVIDER=fake
TTS_PROVIDER=fake
WORKER_CONCURRENCY=1

# Frontend (Vite). Empty base URL = same-origin /api via dev proxy or nginx.
VITE_API_BASE_URL=
VITE_DEFAULT_SOURCE_LANGUAGE=auto
# Optional UI preselect only; must also appear in GET /api/capabilities.
# VITE_DEFAULT_TARGET_LANGUAGE=vi-VN
