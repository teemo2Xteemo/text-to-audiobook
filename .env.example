# Copy to .env and adjust. Do not commit .env.
# Names only — put credentials in the untracked .env file, never here.

REDIS_URL=redis://redis:6379/0
# Must be a real directory, not a symlink. Compose bind-mounts ./storage here.
# The API/worker entrypoint lchown's this tree as root on every start (can be
# slow as storage/ grows), then drops to uid 1000.
STORAGE_PATH=/data/storage
OUTPUT_BITRATE_KBPS=128
MAX_UPLOAD_BYTES=2000000

# M5 defaults: offline fakes. Override later for real providers, e.g.:
# TRANSLATION_PROVIDER=nllb
# TTS_PROVIDER=edge
# Optional per-language default (vendor voice IDs). Unset = first voices_for() entry.
# TTS_DEFAULT_VOICE_BY_LANGUAGE=vi-VN=vi-VN-HoaiMyNeural,zh-CN=zh-CN-XiaoxiaoNeural
TRANSLATION_PROVIDER=fake
TTS_PROVIDER=fake
WORKER_CONCURRENCY=1
# Bounded concurrency for chunks inside a single job:
CHUNK_TRANSLATION_CONCURRENCY=2
CHUNK_TTS_CONCURRENCY=2
# WORKER_CONCURRENCY>1 forks extra RQ worker processes inside one container. It is
# experimental: dead children are not restarted and shutdown waits only 5s. Prefer
# `docker compose up --scale worker=N` for more capacity. Per-job locking uses flock, so
# all workers must share one host and a local (non-NFS) STORAGE_PATH.
NLLB_MODEL_ID=facebook/nllb-200-distilled-600M
# Optional literary translation (ADR 0011). Leave TRANSLATION_PROVIDER=fake/nllb
# unless Ollama is running with a pulled TranslateGemma (or compatible) model.
# Compose defaults OLLAMA_BASE_URL to host.docker.internal (api/worker extra_hosts).
# Host-run worker (no Compose): OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_TRANSLATION_MODEL=translategemma:4b
# Per-request HTTP timeout; distinct from RQ_JOB_TIMEOUT_SECONDS.
# OLLAMA_HTTP_TIMEOUT_SECONDS=120
# Optional Google Gemini translation provider (TRANSLATION_PROVIDER=gemini)
# GEMINI_API_KEY=
# GEMINI_TRANSLATION_MODEL=gemini-3.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_HTTP_TIMEOUT_SECONDS=60
# Optional Groq translation provider (TRANSLATION_PROVIDER=groq)
# GROQ_API_KEY=
# GROQ_TRANSLATION_MODEL=qwen/qwen3.8-27b
# Curated profiles: groq-qwen, groq-gpt-oss-120b (openai/gpt-oss-120b),
# groq-gpt-oss-20b (openai/gpt-oss-20b). A saved pin that still names a
# retired Llama id is rewritten to the matching gpt-oss model.
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_HTTP_TIMEOUT_SECONDS=60
# Optional OpenRouter translation provider (TRANSLATION_PROVIDER=openrouter)
# OPENROUTER_API_KEY=
# Default profile when this provider is selected: openrouter-deepseek-v4-flash.
# OPENROUTER_TRANSLATION_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_TIMEOUT_SECONDS=60
LANGUAGE_DETECT_MIN_CONFIDENCE=0.5
LANGUAGE_CONFIRM_THRESHOLD=0.70
TTS_PREVIEW_RATE_PER_MINUTE=30
ESTIMATE_CHARS_PER_SECOND=15.0
ESTIMATE_TRANSLATION_EXPANSION=1.2
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=1
# Crash recovery cap (distinct from RETRY_MAX_ATTEMPTS, which is per-chunk provider
# retries). On worker boot, a job that was already running (not QUEUED) is re-enqueued and
# counted; after this many recoveries without chunk progress it is marked FAILED.
MAX_RECOVERY_ATTEMPTS=3
# RQ kills the worker function after this many seconds. CPU NLLB first load
# can exceed RQ's 180s default (~172s still translating on a 8 GB box). Raise
# on slower hosts; lower only if you want failed jobs sooner.
RQ_JOB_TIMEOUT_SECONDS=1800

# Compose worker only: Hugging Face cache inside the container (not a Settings field).
# First NLLB run downloads distilled weights into this path (named volume huggingface-cache).
# HF_HOME=/data/huggingface

# Frontend (Vite). Empty base URL = same-origin /api via nginx or the Vite dev proxy.
# VITE_* are baked at frontend image build. After changing them: docker compose up --build
VITE_API_BASE_URL=
VITE_DEFAULT_SOURCE_LANGUAGE=auto
# Optional UI preselect only; must also appear in GET /api/capabilities.
# VITE_DEFAULT_TARGET_LANGUAGE=vi-VN
