# Worker image: FFmpeg + CPU torch + Edge TTS. Do not add CUDA or secrets.
# Do not COPY model weights into the image.

FROM python:3.12-slim AS builder

WORKDIR /src
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY pyproject.toml ./
COPY app ./app
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir ".[nllb,edge]"

FROM python:3.12-slim AS runtime

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    HF_HOME=/data/huggingface

RUN groupadd --system --gid 1000 app \
    && useradd --system --uid 1000 --gid app --home /app --no-create-home app \
    && apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libgomp1 \
    && mkdir -p /data/huggingface \
    && chown app:app /data/huggingface \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv

USER app

CMD ["python", "-m", "app.workers"]
